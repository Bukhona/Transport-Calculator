<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FB"
    tools:context=".ResultsActivity">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transport Results"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/lblDailyCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Cost (R)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="35dp"
        android:layout_marginStart="30dp" />

    <TextView
        android:id="@+id/txtDailyCost"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="R0.00"
        android:textSize="18sp"
        android:textColor="#000000"
        android:gravity="center"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/lblDailyCost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/lblMonthlyCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monthly Cost (R)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtDailyCost"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp" />

    <TextView
        android:id="@+id/txtMonthlyCost"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="R0.00"
        android:textSize="18sp"
        android:textColor="#000000"
        android:gravity="center"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/lblMonthlyCost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/lblMonthlyDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monthly Distance (km)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtMonthlyCost"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp" />

    <TextView
        android:id="@+id/txtMonthlyDistance"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="0 km"
        android:textSize="18sp"
        android:textColor="#000000"
        android:gravity="center"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/lblMonthlyDistance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/lblCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cost Category"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtMonthlyDistance"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp" />

    <TextView
        android:id="@+id/txtCategory"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="Low Cost"
        android:textSize="18sp"
        android:textColor="#000000"
        android:gravity="center"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/lblCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/lblRecom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recommendation"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtCategory"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp" />

    <TextView
        android:id="@+id/txtRecom"
        android:layout_width="300dp"
        android:layout_height="80dp"
        android:text="Recommendation will appear here"
        android:textSize="16sp"
        android:textColor="#000000"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/lblRecom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:text="Save Report"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtRecom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:text="Back to Menu"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp" />





</androidx.constraintlayout.widget.ConstraintLayout>