<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FB"
    tools:context=".DetailsActivity">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Transport Details"
        android:textColor="#0D47A1"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lblTrans"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transport Type"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="35dp"
        android:layout_marginStart="30dp" />

    <Spinner
        android:id="@+id/sprTrans"
        android:layout_width="300dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/lblTrans"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/lblDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distance per Day (km)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/sprTrans"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp" />

    <EditText
        android:id="@+id/txtDistance"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:hint="Enter distance in kilometres"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/lblDistance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/lblCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cost per Kilometre (R)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtDistance"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp" />

    <EditText
        android:id="@+id/txtCost"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:hint="Enter cost per kilometre"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/lblCost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/lblDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Travel Days"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtCost"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp" />

    <Button
        android:id="@+id/txtDays"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="Select Travel Dates"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/lblDays"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnCalc"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:text="Calculate"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtDays"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp" />

    <Button
        android:id="@+id/btnClear"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#0D47A1"
        android:text="Clear"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCalc" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:text="Back to Menu"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/btnClear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp" />

</androidx.constraintlayout.widget.ConstraintLayout>