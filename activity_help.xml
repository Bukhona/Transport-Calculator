<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FB"
    tools:context=".HelpActivity">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Help"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/lblHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How to Use the App"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="35dp"
        android:layout_marginStart="30dp" />

    <TextView
        android:id="@+id/txtHelp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="1. Home Screen&#10;Use Start Calculation to begin. Use Listen to Me for audio guidance and Exit to close the application.&#10;&#10;2. Details Screen&#10;Select a transport type, enter the distance per day, cost per kilometre and travel days. Tap Calculate to continue.&#10;&#10;3. Results Screen&#10;View the daily cost, monthly cost, monthly distance, cost category and recommendation. Tap Save Report to save the report.&#10;&#10;4. Reports Screen&#10;View previously saved transport reports.&#10;&#10;5. Navigation&#10;Use the menu options Home, Details, Reports and Help to move between the main sections of the application."
        android:textSize="16sp"
        android:textColor="#000000"
        android:lineSpacingExtra="4dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/lblHelp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:text="Back to Menu"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D47A1"
        app:layout_constraintTop_toBottomOf="@id/txtHelp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />


</androidx.constraintlayout.widget.ConstraintLayout>